# Copy to android/keystore.properties and fill in the real values.
# Never commit keystore.properties or the .keystore file.
# Path is relative to android/app/
CHOLBE_UPLOAD_STORE_FILE=cholbe-upload.keystore
CHOLBE_UPLOAD_KEY_ALIAS=cholbe-upload
CHOLBE_UPLOAD_STORE_PASSWORD=
CHOLBE_UPLOAD_KEY_PASSWORD=
